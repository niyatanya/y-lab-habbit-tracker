<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Habit Tracker Web Application</display-name>

    <listener>
        <listener-class>org.home.StartupListener</listener-class>
    </listener>

    <context-param>
        <param-name>dbUrl</param-name>
        <param-value>jdbc:postgresql://localhost:5432/habittrackerdb</param-value>
    </context-param>
    <context-param>
        <param-name>dbUser</param-name>
        <param-value>habittrackeruser</param-value>
    </context-param>
    <context-param>
        <param-name>dbPassword</param-name>
        <param-value>pass123</param-value>
    </context-param>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>org.home.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UserServlet</servlet-name>
        <servlet-class>org.home.servlet.UserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserServlet</servlet-name>
        <url-pattern>/secured/users/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>HabitServlet</servlet-name>
        <servlet-class>org.home.servlet.HabitServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HabitServlet</servlet-name>
        <url-pattern>/secured/habits/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>HabitRecordServlet</servlet-name>
        <servlet-class>org.home.servlet.HabitRecordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HabitRecordServlet</servlet-name>
        <url-pattern>/secured/records/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StatisticsServlet</servlet-name>
        <servlet-class>org.home.servlet.StatisticsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StatisticsServlet</servlet-name>
        <url-pattern>/secured/statistics/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminActionsServlet</servlet-name>
        <servlet-class>org.home.servlet.AdminActionsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminActionsServlet</servlet-name>
        <url-pattern>/secured/admin/users/*</url-pattern>
    </servlet-mapping>

    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>org.home.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/secured/*</url-pattern>
    </filter-mapping>

</web-app>
